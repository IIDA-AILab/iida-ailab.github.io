---
layout: default
---
<div class="post members-page">
  <article>
    {% if content and content != '' %}
      <div class="members-intro">{{ content }}</div>
    {% endif %}

    {% if page.member_sections %}
      {% for section in page.member_sections %}
        {% assign section_slug = section.title | slugify %}
        <section class="members-section" id="{{ section_slug }}">
          <div class="members-section-header">
            <p class="members-section-kicker">Members</p>
            <h2>{{ section.title }}</h2>
          </div>

          <div class="members-grid{% if section.compact %} members-grid-compact{% endif %}">
            {% for member in section.members %}
              <article class="member-card{% if member.featured %} member-card-featured{% endif %}{% if section.compact %} member-card-compact{% endif %}">
                <div class="member-card-media">
                  {% if member.image %}
                    {% assign member_image_path = member.image | prepend: 'assets/img/' %}
                    {% if member.image_circular == false %}
                      {% assign member_image_class = 'img-fluid z-depth-1 rounded' %}
                    {% else %}
                      {% assign member_image_class = 'img-fluid z-depth-1 rounded-circle' %}
                    {% endif %}
                    {% include figure.liquid loading="eager" path=member_image_path class=member_image_class sizes="(min-width: 768px) 280px, 90vw" alt=member.name %}
                  {% else %}
                    <div class="member-card-placeholder">{{ member.name | slice: 0 }}</div>
                  {% endif %}
                </div>

                <div class="member-card-body">
                  <div class="member-card-heading">
                    <h3>{{ member.name }}</h3>
                    {% if member.role %}
                      <p class="member-role">{{ member.role }}</p>
                    {% endif %}
                  </div>

                  {% if section.compact %}
                    {% if member.education %}
                      <p class="member-meta"><strong>Education</strong> {{ member.education | join: ', ' }}</p>
                    {% endif %}
                    {% if member.research_areas %}
                      <p class="member-meta"><strong>Research</strong> {{ member.research_areas | join: ', ' }}</p>
                    {% endif %}
                    {% if member.email or member.phone or member.office %}
                      <p class="member-meta">
                        {% if member.email %}
                          <span><strong>Email</strong> <a href="mailto:{{ member.email }}">{{ member.email }}</a></span>
                        {% endif %}
                        {% if member.phone %}
                          <span><strong>Phone</strong> {{ member.phone }}</span>
                        {% endif %}
                        {% if member.office %}
                          <span><strong>Office</strong> {{ member.office }}</span>
                        {% endif %}
                      </p>
                    {% endif %}
                  {% else %}
                    {% if member.education %}
                      <div class="member-detail-block">
                        <h4>Education</h4>
                        <ul>
                          {% for item in member.education %}
                            <li>{{ item }}</li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% endif %}

                    {% if member.research_areas %}
                      <div class="member-detail-block">
                        <h4>Research Areas</h4>
                        <ul class="member-tags">
                          {% for item in member.research_areas %}
                            <li>{{ item }}</li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% endif %}

                    {% if member.contact or member.email or member.phone or member.office or member.website %}
                      <div class="member-detail-block">
                        <h4>Contact</h4>
                        <ul class="member-contact-list">
                          {% if member.email %}
                            <li><strong>Email</strong> <a href="mailto:{{ member.email }}">{{ member.email }}</a></li>
                          {% endif %}
                          {% if member.phone %}
                            <li><strong>Phone</strong> {{ member.phone }}</li>
                          {% endif %}
                          {% if member.office %}
                            <li><strong>Office</strong> {{ member.office }}</li>
                          {% endif %}
                          {% if member.website %}
                            <li><strong>Website</strong> <a href="{{ member.website }}">{{ member.website }}</a></li>
                          {% endif %}
                          {% if member.contact %}
                            {% for item in member.contact %}
                              <li>{{ item }}</li>
                            {% endfor %}
                          {% endif %}
                        </ul>
                      </div>
                    {% endif %}

                    {% if member.bio %}
                      <div class="member-bio">{{ member.bio | markdownify }}</div>
                    {% endif %}
                  {% endif %}
                </div>
              </article>
            {% endfor %}
          </div>
        </section>
      {% endfor %}
    {% endif %}
  </article>
</div>
