---
layout: default
---
<div class="post members-page">
  <article>
    {% if content and content != '' %}
      <div class="members-intro">{{ content }}</div>
    {% endif %}

    {% if page.member_sections %}
      {% for section in page.member_sections %}
        {% assign section_slug = section.title | slugify %}
        <section class="members-section" id="{{ section_slug }}">
          <div class="members-section-header">
            <h2>{{ section.title }}</h2>
          </div>

          <div
            class="members-grid{% if section.compact %} members-grid-compact{% endif %}"
            style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.25rem;"
          >
            {% for member in section.members %}
              <article class="member-card{% if member.featured %} member-card-featured{% endif %}{% if section.compact %} member-card-compact{% endif %}">
                <div class="member-card-media">
                  {% if member.image %}
                    {% assign member_image_path = member.image | prepend: 'assets/img/' %}
                    {% if member.image_circular == false %}
                      {% assign member_image_class = 'img-fluid z-depth-1 rounded' %}
                    {% else %}
                      {% assign member_image_class = 'img-fluid z-depth-1 rounded-circle' %}
                    {% endif %}
                    {% include figure.liquid loading="eager" path=member_image_path class=member_image_class sizes="(min-width: 768px) 280px, 90vw" alt=member.name %}
                  {% else %}
                    <div class="member-card-placeholder">{{ member.name | slice: 0 }}</div>
                  {% endif %}
                </div>

                <div class="member-card-body">
                  <div class="member-card-heading">
                    <h3>{{ member.name }}</h3>
                    {% if member.role %}
                      <p class="member-role">{{ member.role }}</p>
                    {% endif %}
                  </div>

                  {% if member.education %}
                    <div class="member-text-list">
                      {% for item in member.education %}
                        <p>{{ item }}</p>
                      {% endfor %}
                    </div>
                  {% endif %}

                  {% if member.research_areas %}
                    <div class="member-text-list">
                      {% for item in member.research_areas %}
                        <p>{{ item }}</p>
                      {% endfor %}
                    </div>
                  {% endif %}

                  {% if member.phone or member.office or member.contact %}
                    <div class="member-text-list">
                      {% if member.phone %}
                        <p>{{ member.phone }}</p>
                      {% endif %}
                      {% if member.office %}
                        <p>{{ member.office }}</p>
                      {% endif %}
                      {% if member.contact %}
                        {% for item in member.contact %}
                          <p>{{ item }}</p>
                        {% endfor %}
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if member.bio and section.compact != true %}
                    <div class="member-bio">{{ member.bio | markdownify }}</div>
                  {% endif %}

                  {% if member.email or member.website or member.github %}
                    <div class="member-links">
                      {% if member.email %}
                        <a href="mailto:{{ member.email }}" aria-label="{{ member.name }} email" title="Email">
                          <i class="fa-solid fa-envelope"></i>
                        </a>
                      {% endif %}
                      {% if member.website %}
                        <a href="{{ member.website }}" aria-label="{{ member.name }} website" title="Website">
                          <i class="fa-solid fa-house"></i>
                        </a>
                      {% endif %}
                      {% if member.github %}
                        <a href="{{ member.github }}" aria-label="{{ member.name }} GitHub" title="GitHub">
                          <i class="fa-brands fa-github"></i>
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </article>
            {% endfor %}
          </div>
        </section>
      {% endfor %}
    {% endif %}
  </article>
</div>
